# Porkbun CLI Environment Configuration Example
# Rename this file to .env and add your actual values

# API Credentials (required)
PORKBUN_API_KEY=your_api_key_here
PORKBUN_SECRET_API_KEY=your_secret_api_key_here

# Optional Configuration
PORKBUN_API_ENDPOINT=https://porkbun.com/api/json/v3
PORKBUN_TIMEOUT=30
PORKBUN_DEFAULT_TTL=600

# Default values for services
DEFAULT_DOMAIN=example.com
DEFAULT_TEMPLATE_DIR=examples/templates

# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=porkbun.log 